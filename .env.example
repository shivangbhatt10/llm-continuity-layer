# Gemini API Key (Required for live execution; not required for --dry-run or unit tests)
GEMINI_API_KEY=""

# Model Routing Precedence (Gotcha #12)
# ML_MODEL overrides both cheap and strong models if set.
# If unset, the system uses ML_CHEAP_MODEL for classification/chunking
# and ML_STRONG_MODEL for state capsule synthesis.
ML_CHEAP_MODEL="gemini-3.1-flash-lite"
ML_STRONG_MODEL="gemini-3.8-flash"
# ML_MODEL="gemini-3.8-flash"
